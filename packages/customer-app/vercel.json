{
  "buildCommand": "cd ../.. && npm run build:customer && echo '{\"version\":1,\"outDirectory\":\"out\"}' > packages/customer-app/.next/export-detail.json",
  "installCommand": "cd ../.. && npm install",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/sync-airalo-v2",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "origin-when-cross-origin"
        }
      ]
    }
  ]
}
