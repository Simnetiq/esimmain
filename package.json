{
  "name": "esim-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for eSIM customer and admin applications",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm run dev --workspace=packages/customer-app",
    "dev:admin": "npm run dev --workspace=packages/admin-app",
    "dev:shared": "npm run dev --workspace=packages/shared",
    "build:customer": "npm run build --workspace=packages/customer-app",
    "build:admin": "npm run build --workspace=packages/admin-app",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:all": "npm run build:shared && npm run build:customer && npm run build:admin",
    "start:customer": "npm run start --workspace=packages/customer-app",
    "start:admin": "npm run start --workspace=packages/admin-app",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf packages/*/node_modules packages/*/.next packages/*/dist node_modules"
  },
  "keywords": [
    "esim",
    "nextjs",
    "firebase",
    "stripe",
    "react",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.0",
    "autoprefixer": "^10.4.21",
    "critters": "^0.0.23",
    "eslint": "^8.0.0",
    "eslint-config-next": "^16.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "next": ">=14.2.35",
    "node-fetch": "^3.3.2",
    "stripe": "^20.0.0"
  },
  "overrides": {
    "eslint-config-next": {
      "eslint": "^8.57.1"
    }
  }
}
